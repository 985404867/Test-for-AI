# OpenAI API Key。这里不要写进代码，真实项目里也不要提交 .env 文件。
OPENAI_API_KEY=your_api_key_here

# 模型名称。你可以换成自己账号或接口支持的模型。
OPENAI_MODEL=deepseek-chat

# OpenAI 兼容接口地址。
# 留空表示使用官方 OpenAI 接口；填写后会走你自己的网关/代理/兼容服务。
OPENAI_BASE_URL=https://api.deepseek.com

# RAG 向量模型。local 不需要额外接口；openai 会调用兼容接口的 embeddings API。
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small

# 温度：0 更稳定，1 更发散。学习和工具型项目建议先用 0.2。
OPENAI_TEMPERATURE=0.2

# 最大输出 token 数。回答太短时可以调大；留空则交给模型服务默认值。
OPENAI_MAX_TOKENS=8192

# 如果模型因为长度上限停止，自动继续请求并拼接回答。
AUTO_CONTINUE_ENABLED=true
AUTO_CONTINUE_MAX_ROUNDS=4

# RAG 检索时返回多少段上下文。
RETRIEVER_K=4

# 本地知识库文件路径。
KNOWLEDGE_PATH=data/knowledge.md

# 联网搜索配置。GUI 中也可以临时勾选/取消。
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT=8
WEB_SEARCH_FETCH_PAGES=true
WEB_SEARCH_PAGE_CHARS=1600
